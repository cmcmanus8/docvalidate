<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="002-validation-request" author="calum">
        <createTable tableName="validation_request" schemaName="validation">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_validation_request"/>
            </column>
            <column name="status" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="idempotency_key" type="varchar(255)"/>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Partial index: many rows legitimately have no key, and NULLs must not collide. -->
        <sql>
            CREATE UNIQUE INDEX ux_validation_request_idempotency_key
                ON validation.validation_request (idempotency_key)
             WHERE idempotency_key IS NOT NULL
        </sql>

        <createIndex indexName="ix_validation_request_status"
                     tableName="validation_request"
                     schemaName="validation">
            <column name="status"/>
        </createIndex>

        <rollback>
            <dropTable tableName="validation_request" schemaName="validation"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
